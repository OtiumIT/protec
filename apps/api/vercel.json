{
  "version": 2,
  "buildCommand": "cd ../.. && pnpm install && pnpm run build:api",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "env": {
    "NODEJS_HELPERS": "0"
  }
}
